@baseUrl = http://localhost:5000
# Вставте сюди token з відповіді реєстрації / логіну
@token = PASTE_TOKEN_HERE

### Реєстрація (повертає { user, token })
POST {{baseUrl}}/users
Content-Type: application/json

{
  "name": "Artem",
  "email": "artem@gmail.com",
  "password": "qwerty123"
}

### Логін (повертає { user, token })
POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "artem@gmail.com",
  "password": "qwerty123"
}

### Поточний користувач
GET {{baseUrl}}/users/me
Authorization: Bearer {{token}}

### Оновити профіль (можна передати лише name або лише email)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Artem updated"
}

### Змінити пароль (204 No Content)
PATCH {{baseUrl}}/users/me/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "qwerty123",
  "newPassword": "qwerty111"
}

### Видалити акаунт (204 No Content)
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{token}}
